tests/jmeter/report/
tests/jmeter/results/
tests/jmeter/results.jtl
tests/jmeter/test_files.csv
tests/jmeter/test_novel.txt

# ============================================================================
# 废弃代码归档（本地保留历史记录；入库需 git add -f）
# ============================================================================
deprecated/

# ============================================================================
# 测试根目录文件不上传（显式保留 conftest.py 与边界锁测试）
# ============================================================================
/tests/*.py
!/tests/conftest.py
!/tests/__init__.py
!/tests/test_api_work_boundary.py
