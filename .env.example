DATABASE_URL=postgresql+psycopg://localhost:5432/novel_analysis
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/novel_analysis_test
TEST_DATABASE_USERNAME=postgres
TEST_DATABASE_PASSWORD=your_password
# 连接池与语句超时（可选覆盖，缺省值见注释；不设置即用默认值）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT=30000
# DB_ECHO=false
# 模型池由设置页编辑，每个模型独立配置 URL、Key、ID、上下文容量、采样参数（temperature/top_p/max_tokens）、权重和并发
MODEL_POOL='[{"model_id":"deepseek-v4-flash","base_url":"https://api.deepseek.com","api_key":"your-api-key-here","context_window_tokens":131072,"weight":1,"max_in_flight":8,"temperature":0.7,"top_p":0.8,"max_tokens":131072}]'
DIAGNOSIS_MODEL_ID=deepseek-v4-flash
EMBEDDING_MODEL_BASE_URL=http://localhost:8080/v1
EMBEDDING_MODEL_ID=ritrieve-zh
EMBEDDING_MODEL_KEY=sk-no-key-required
# LTP 离线模型目录（必配）：LTP 从该目录加载，不自动联网下载
LTP_MODEL_DIR=models/ltp/small
